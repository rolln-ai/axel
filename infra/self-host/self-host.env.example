# Generated securely by `./scripts/axel-self-host init`.
# This reference lists the required operator-supplied values; do not use these
# placeholder secrets or identifiers in a deployment.

AXEL_DEPLOYMENT_MODE=self-hosted
AXEL_INSTALLATION_ID=generated-32-character-hex-id
AXEL_SITE_ADDRESS=http://localhost:8080
AXEL_PUBLIC_URL=http://localhost:8080
AXEL_DELIVERY_PUBLIC_URL=http://localhost:8080
AXEL_RESOURCE_PREFIX=axel-selfhost-generated-random-suffix
AXEL_HTTP_PORT=80
AXEL_HTTPS_PORT=443
AXEL_PUBLISH_PUBLIC_PORTS=0
AXEL_LOCAL_BIND_ADDRESS=127.0.0.1
AXEL_LOCAL_PORT=8080

CLOUDFLARE_ACCOUNT_ID=
# Required provisioning token used only to create and configure resources.
CLOUDFLARE_API_TOKEN=
# Required Queue/R2 runtime token for application containers. It must be a
# distinct, narrower credential and must not reuse CLOUDFLARE_API_TOKEN.
CLOUDFLARE_RUNTIME_API_TOKEN=
DELIVERY_QUEUE_ID=
RAW_PAYLOAD_BUCKET=
NEXT_PUBLIC_AXEL_INGEST_URL=

POSTGRES_PASSWORD=generated-by-init
CREDENTIALS_MASTER_KEY=
DELIVERY_SHARED_SECRET=generated-by-init
SOURCE_LOOKUP_SHARED_SECRET=generated-by-init
INGEST_ADMIN_TOKEN=generated-by-init
CRON_SECRET=generated-by-init
