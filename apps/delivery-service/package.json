{
  "name": "@axel/delivery-service",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo 'delivery-service runs source via tsx — no bundle step' && exit 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm --filter @axel/shared build && tsx src/server.ts",
    "dev": "tsx src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1070.0",
    "@axel/connectors": "workspace:*",
    "@axel/delivery-worker": "workspace:*",
    "@axel/observability": "workspace:*",
    "@axel/router": "workspace:*",
    "@axel/shared": "workspace:*",
    "@smithy/node-http-handler": "4.7.6",
    "mongodb": "^7.2.0",
    "parquetjs-lite": "^0.8.7",
    "pg": "^8.21.0",
    "tsx": "^4.22.4",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@axel/test-utils": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
