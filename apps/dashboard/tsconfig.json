{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next-specific overrides on top of tsconfig.base.json.
    "allowJs": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "plugins": [{ "name": "next" }],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    // Known strictness hole: the base config enables exactOptionalPropertyTypes,
    // but the dashboard predates it and has not been migrated yet. Keep this
    // override explicit (rather than hand-copying the whole config) so the
    // drift stays visible. Do not flip without fixing the resulting errors.
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
