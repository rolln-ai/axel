{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@axel/dashboard#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@axel/marketing#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@axel/shared#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@axel/observability#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@axel/cli#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@axel/connectors#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@axel/pull-connectors#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
