{
  "id": "axel-webhooks-env",
  "name": "Axel cloud, synthetic tests",
  "values": [
    {
      "key": "baseUrl",
      "value": "https://ingest.axelapp.ai",
      "type": "default",
      "enabled": true
    },
    {
      "key": "sourceId",
      "value": "src_replace_me",
      "type": "default",
      "enabled": true,
      "description": "Create a disposable source that receives synthetic test data only, then paste its source ID here."
    },
    {
      "key": "sourceToken",
      "value": "PASTE_YOUR_TOKEN_HERE",
      "type": "secret",
      "enabled": true,
      "description": "The disposable source token shown once during source creation. Do not share or export a populated environment."
    }
  ],
  "_postman_variable_scope": "environment"
}
