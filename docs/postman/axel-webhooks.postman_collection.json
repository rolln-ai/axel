          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/in/{{sourceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["in", "{{sourceId}}"]
            }
          }
        },
        {
          "name": "Body too large → 413",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Build a string > 1MB so the worker rejects with 413.",
                  "const huge = 'x'.repeat(1_100_000);",
                  "pm.variables.set('hugeBody', JSON.stringify({ payload: huge }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 413', () => pm.response.to.have.status(413));",
                  "pm.test('Returns payload_too_large', () => {",
                  "  pm.expect(pm.response.json().error).to.eql('payload_too_large');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "content-type", "value": "application/json" },
              { "key": "x-axel-token", "value": "{{sourceToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{{hugeBody}}" },
            "url": {
              "raw": "{{baseUrl}}/in/{{sourceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["in", "{{sourceId}}"]
            },
            "description": "Default body cap is 1 MB per source. The pre-request script generates 1.1 MB so the worker bounces it before storage. Caps are configurable per source on the Sources page."
          }
        },
        {
          "name": "Body too deep → 413",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 200-level nested object, deeper than the default 100 cap.",
                  "let body = { leaf: true };",
                  "for (let i = 0; i < 200; i++) body = { wrap: body };",
                  "pm.variables.set('deepBody', JSON.stringify(body));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 413', () => pm.response.to.have.status(413));",
                  "pm.test('Returns payload_too_deep', () => {",
                  "  pm.expect(pm.response.json().error).to.eql('payload_too_deep');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "content-type", "value": "application/json" },
              { "key": "x-axel-token", "value": "{{sourceToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{{deepBody}}" },
            "url": {
              "raw": "{{baseUrl}}/in/{{sourceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["in", "{{sourceId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Replay & inspect",
      "description": "Use https://app.axelapp.ai/usage for synthetic event counts, https://app.axelapp.ai/deliveries for failed deliveries and replay, and https://app.axelapp.ai/sources for source status.\n\nDo not send Axel traffic to a public request-bin service. Such services can retain request bodies and headers. Use an HTTP endpoint you operate and synthetic payloads only.",
      "item": []
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request: warn if the environment is incomplete.",
          "const token = pm.environment.get('sourceToken');",
          "if (!token || token === 'PASTE_YOUR_TOKEN_HERE') {",
          "  console.warn('sourceToken is not set. Paste the disposable source token into the private environment.');",
          "}"
        ]
      }
    }
  ],
  "variable": []
}
