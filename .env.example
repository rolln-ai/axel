# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Dashboard-only R2 runtime credential. Hosted deployments should use a
# separate R2-only token; self-host maps this to the runtime token below.
CLOUDFLARE_R2_API_TOKEN=
# Self-host only: required Queue/R2 runtime token. Keep Worker-deployment and
# resource-provisioning permission on CLOUDFLARE_API_TOKEN out of containers.
CLOUDFLARE_RUNTIME_API_TOKEN=

# Linear workflow automation (maintainer-only tooling — not needed to run or develop Axel)
LINEAR_API_KEY=

# Local dev source-config stub
AXEL_DEV_SOURCES_JSON=./infra/dev-sources.json

# Postgres
DATABASE_URL=
DATABASE_POOL_MAX=5
# Set true for a remote control-plane database with a publicly trusted CA.
# Local Compose uses an explicit sslmode=disable connection instead.
CONTROL_PLANE_DB_SSL_VERIFY=

# ClickHouse — self-hosted on Render (axel-clickhouse).
# CLICKHOUSE_URL is the HTTPS endpoint, e.g. https://axel-clickhouse.onrender.com
# CLICKHOUSE_USER/CLICKHOUSE_PASSWORD must match the values set on the
# axel-clickhouse service in render.yaml; the official image bootstraps the
# `default` user with that password on first boot.
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Daily ClickHouse backup → Cloudflare R2 (GitHub Actions only — NOT needed
# in any runtime service). Used by .github/workflows/clickhouse-backup.yml.
# Endpoint format: https://<cf-account-id>.r2.cloudflarestorage.com
# Bucket should have a 7-day lifecycle rule on the `clickhouse-backups/` prefix.
CLICKHOUSE_BACKUP_S3_ENDPOINT=
CLICKHOUSE_BACKUP_S3_BUCKET=
CLICKHOUSE_BACKUP_S3_ACCESS_KEY=
CLICKHOUSE_BACKUP_S3_SECRET_KEY=

# Vercel frontend deploys
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID_DASHBOARD=
VERCEL_PROJECT_ID_MARKETING=
NEXT_PUBLIC_AXEL_APP_URL=https://app.axelapp.ai
NEXT_PUBLIC_AXEL_INGEST_URL=https://ingest.axelapp.ai
# Public contact address used by the marketing site. When unset, support links
# point to GitHub Discussions. This value is embedded in the browser bundle and
# must not contain a private address or secret.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Explicitly prevents self-hosted services from falling back to Axel Cloud URLs.
AXEL_DEPLOYMENT_MODE=

# Sentry runtime error reporting + dashboard production source-map upload.
# The DSN is public by design and next.config exposes it to the browser SDK.
# SENTRY_AUTH_TOKEN is a sensitive organization token used by Vercel production
# builds and protected GitHub production deploys; grant least-privilege `org:ci`.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=javascript

# Render API deployments and secret synchronization
RENDER_API_KEY=

# MongoDB Atlas test cluster
MONGODB_TEST_URI=

# QA / end-to-end test fixtures — Railway sandbox databases used by the
# Playwright pipeline tests (apps/e2e and ad-hoc scripts under /tmp/axel-qa).
# Both are isolated throwaway clusters; safe for the test harness to seed,
# create routes against, and tear down. NEVER set these to a production DSN.
#
#   - QA_PG_DSN seeds + acts as the Postgres source for end-to-end runs.
#     Expected table: qa_bot_events (see scripts/qa-seed.sql).
#   - QA_MONGO_URI is the destination MongoDB the route fans events out to.
#     Database name `axel_qa` is conventional; collection picked per-route.
QA_PG_DSN=
QA_MONGO_URI=

# Ingest worker admin endpoint shared secret (source authority and maintenance).
# When unset, the admin route returns 404 (effectively disabled).
ADMIN_TOKEN=

# Dashboard to ingest-worker source authority. Both must be set together.
# Mutations fence before their database write and publish freshly committed
# source state before ingest can authorize the source again.
INGEST_ADMIN_URL=https://ingest.axelapp.ai/admin/source-cache/invalidate
INGEST_ADMIN_TOKEN=

# Router/delivery alert webhook (Slack/PagerDuty/Sentry compatible JSON POST)
# When unset, the router boots silentAlertSink() and never pages anyone.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# OpenRouter: optional Data Contract inference and delivery-failure explanations.
# Axel sends schema field names, object/array shape, primitive type markers, and
# allowlisted operational context. It does not send raw webhook values, destination
# names, connector/response text, event-type filter values, or custom transform
# separators. When unset, these flows use deterministic inference or show that AI
# explanations are unavailable.
# Get a key at https://openrouter.ai/keys.
# Model defaults to anthropic/claude-haiku-4.5; override via OPENROUTER_MODEL.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Resend — transactional email (password reset, workspace invites, alerts).
# Get a key at https://resend.com/api-keys. RESEND_FROM_EMAIL must be a verified
# domain or sender in Resend (e.g. "Axel <noreply@axelapp.ai>").
# When unset, production email actions fail without logging recipients or links.
# Local `next dev` keeps a console fallback for end-to-end development.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shared delivery auth between edge workers and native delivery service.
DELIVERY_SHARED_SECRET=
# Dedicated auth for ingest-worker source lookups. During a rotation only,
# delivery-service may also set SOURCE_LOOKUP_SHARED_SECRET_PREVIOUS.
SOURCE_LOOKUP_SHARED_SECRET=
# Worker-only HMAC key for pseudonymous FIFO ordering keys (32+ characters).
ORDERING_KEY_HMAC_SECRET=
DELIVERY_SERVICE_URL=
DELIVERY_QUEUE_ID=
DELIVERY_NATIVE_QUEUE_ID=

# Authenticates calls to the dashboard's /api/cron/* routes. Required outside
# Vercel too; docker-compose.selfhost.yml includes a small scheduler service.
CRON_SECRET=

# Authenticates GET /api/ops/delivery-canary/receipt. Use at least 32 random
# characters. This is only required when a delivery canary is configured.
DELIVERY_CANARY_RECEIPT_TOKEN=

# Destination credential and super-admin TOTP-seed encryption. The same value
# must exist on dashboard, delivery-edge, and delivery-service. Losing it makes
# stored destination credentials and enrolled TOTP seeds unreadable.
CREDENTIALS_MASTER_KEY=

# Stripe — billing & payments (axelapp.ai/pricing).
# Get test/live keys at https://dashboard.stripe.com/apikeys. The
# webhook secret is per-endpoint, set when registering
# `${NEXT_PUBLIC_AXEL_APP_URL}/api/stripe/webhook` in the Stripe
# dashboard. STRIPE_PRICE_BASE_ID is the $20/month flat subscription
# Price and STRIPE_PRICE_METER_ID is the metered Price ($0.03/1k
# overage). STRIPE_METER_EVENT_NAME is the configured Stripe Meter's
# event_name (default "axel_tasks"). All four must be set together
# for the Pro upgrade flow to work; when unset, free-tier-only
# operation is fine and the webhook endpoint returns 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE_ID=
STRIPE_PRICE_METER_ID=
STRIPE_METER_EVENT_NAME=axel_tasks
