#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ENV_FILE="${AXEL_SELF_HOST_ENV:-$ROOT_DIR/.env.selfhost}"
STATE_DIR="${AXEL_SELF_HOST_STATE_DIR:-$ROOT_DIR/.selfhost}"
OWNERSHIP_FILE="$STATE_DIR/ownership.env"
COMPOSE_FILE="$ROOT_DIR/docker-compose.selfhost.yml"
PUBLIC_COMPOSE_FILE="$ROOT_DIR/infra/self-host/docker-compose.public.yml"
WRANGLER_BIN="${AXEL_WRANGLER_BIN:-$ROOT_DIR/node_modules/.bin/wrangler}"
# Capture this one-shot operator acknowledgement before loading the env file so
# it cannot be made persistent accidentally inside .env.selfhost.
ADOPT_EXISTING_RESOURCES="${AXEL_ADOPT_EXISTING_RESOURCES:-}"

usage() {
  cat <<'EOF'
Usage: ./scripts/axel-self-host <command>

  init       Generate .env.selfhost with strong local secrets
  edge       Provision/deploy the Cloudflare Free-tier edge profile
  up         Build and start the private Docker stack
  status     Show container status
  logs       Follow container logs
  down       Stop containers without deleting data
  doctor     Check local prerequisites and configuration

Typical first run: init, edit three Cloudflare/public URL values, edge, up.
EOF
}

need_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "[self-host] missing required command: $1" >&2
    exit 1
  fi
}

load_env() {
  if [ ! -f "$ENV_FILE" ]; then
    echo "[self-host] $ENV_FILE does not exist; run './scripts/axel-self-host init' first" >&2
    exit 1
  fi
  load_env_file "$ENV_FILE"
}

load_env_file() {
  local path="$1"
  local line name value
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ""|\#*) continue ;;
    esac
    name="${line%%=*}"
    value="${line#*=}"
    if [ "$name" = "$line" ] || [[ ! "$name" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
      echo "[self-host] invalid environment entry in $path: $name" >&2
      exit 1
    fi
    # Quoted assignment exports the bytes as data. Never `source` this file:
    # operator-supplied URLs and tokens must not be evaluated as shell code.
    export "$name=$value"
  done < "$path"
}

require_value() {
  local name="$1"
  if [ -z "${!name:-}" ]; then
    echo "[self-host] set $name in $ENV_FILE" >&2
    exit 1
  fi
}

require_strong_secret() {
  local name="$1"
  local value
  require_value "$name"
  value="${!name}"
  if [ "${#value}" -lt 32 ]; then
    echo "[self-host] $name must contain at least 32 characters" >&2
    exit 1
  fi
}

compose() {
  local files=(--env-file "$ENV_FILE" -f "$COMPOSE_FILE")
  if publish_public_ports; then
    files+=(-f "$PUBLIC_COMPOSE_FILE")
  fi
  docker compose "${files[@]}" "$@"
}

publish_public_ports() {
  case "${AXEL_PUBLISH_PUBLIC_PORTS:-}" in
    1) return 0 ;;
    0) return 1 ;;
    "")
      # Compatibility for hand-written/older env files: infer only exact
      # loopback site labels as local. New `init` files record the choice.
      case "${AXEL_SITE_ADDRESS:-}" in
        http://localhost|http://localhost:*|https://localhost|https://localhost:*|localhost|localhost:*|\
        http://127.0.0.1|http://127.0.0.1:*|https://127.0.0.1|https://127.0.0.1:*|127.0.0.1|127.0.0.1:*|\
        http://\[::1\]|http://\[::1\]:*|https://\[::1\]|https://\[::1\]:*|\[::1\]|\[::1\]:*) return 1 ;;
        *) return 0 ;;
      esac
      ;;
    *)
      echo "[self-host] AXEL_PUBLISH_PUBLIC_PORTS must be 0 or 1" >&2
      exit 1
      ;;
  esac
}

wrangler() {
  NO_COLOR=1 "$WRANGLER_BIN" "$@"
}

ensure_wrangler() {
  if [ ! -x "$WRANGLER_BIN" ]; then
    echo "[self-host] installing the pinned Cloudflare provisioner"
    pnpm --dir "$ROOT_DIR" install --frozen-lockfile
  fi
  if [ ! -x "$WRANGLER_BIN" ]; then
    echo "[self-host] Wrangler was not installed at $WRANGLER_BIN" >&2
    exit 1
  fi
}

ownership_value() {
  local wanted="$1"
  local line name value
  [ -f "$OWNERSHIP_FILE" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    name="${line%%=*}"
    value="${line#*=}"
    if [ "$name" = "$wanted" ] && [ "$name" != "$line" ]; then
      printf '%s' "$value"
      return 0
    fi
  done < "$OWNERSHIP_FILE"
  return 1
}

resource_is_owned() {
  local key="$1"
  local name="$2"
  [ "$(ownership_value AXEL_INSTALLATION_ID 2>/dev/null || true)" = "$AXEL_INSTALLATION_ID" ] \
    && [ "$(ownership_value "${key}_ACCOUNT_ID" 2>/dev/null || true)" = "$CLOUDFLARE_ACCOUNT_ID" ] \
    && [ "$(ownership_value "$key" 2>/dev/null || true)" = "$name" ]
}

record_resource_ownership() {
  local key="$1"
  local name="$2"
  node "$ROOT_DIR/scripts/self-host/env-file.mjs" set \
    "$OWNERSHIP_FILE" AXEL_INSTALLATION_ID "$AXEL_INSTALLATION_ID"
  node "$ROOT_DIR/scripts/self-host/env-file.mjs" set \
    "$OWNERSHIP_FILE" "${key}_ACCOUNT_ID" "$CLOUDFLARE_ACCOUNT_ID"
  node "$ROOT_DIR/scripts/self-host/env-file.mjs" set "$OWNERSHIP_FILE" "$key" "$name"
}

authorize_existing_resource() {
  local key="$1"
  local name="$2"
  local kind="$3"
  if resource_is_owned "$key" "$name"; then
    return 0
  fi
  if [ "$ADOPT_EXISTING_RESOURCES" = "1" ]; then
    echo "[self-host] explicitly adopting existing $kind $name"
    return 0
  fi
  echo "[self-host] refusing to reuse pre-existing $kind $name without local ownership proof" >&2
  echo "[self-host] choose a different AXEL_RESOURCE_PREFIX, restore $OWNERSHIP_FILE, or inspect the resource and rerun once with AXEL_ADOPT_EXISTING_RESOURCES=1" >&2
  exit 1
}

ensure_queue() {
  local config="$1"
  local queue="$2"
  local ownership_key="$3"
  if wrangler queues info "$queue" -c "$config" >/dev/null 2>&1; then
    authorize_existing_resource "$ownership_key" "$queue" "queue"
    if ! resource_is_owned "$ownership_key" "$queue"; then
      record_resource_ownership "$ownership_key" "$queue"
    fi
  else
    echo "[self-host] creating queue $queue"
    wrangler queues create "$queue" --message-retention-period-secs 86400 -c "$config"
    record_resource_ownership "$ownership_key" "$queue"
  fi
}

verify_raw_bucket_private() {
  local config="$1"
  local bucket="$2"
  local dev_url_output domain_output
  dev_url_output="$(wrangler r2 bucket dev-url get "$bucket" -c "$config")"
  if ! printf '%s\n' "$dev_url_output" | grep -Fq "Public access via the r2.dev URL is disabled."; then
    echo "[self-host] refusing raw bucket $bucket: public r2.dev access is enabled or could not be verified disabled" >&2
    exit 1
  fi
  domain_output="$(wrangler r2 bucket domain list "$bucket" -c "$config")"
  if ! printf '%s\n' "$domain_output" | grep -Fq "There are no custom domains connected to this bucket."; then
    echo "[self-host] refusing raw bucket $bucket: a custom domain is attached or absence could not be verified" >&2
    exit 1
  fi
}

lifecycle_rule_block() {
  awk -v RS='' '
    $0 ~ /(^|\n)name:[[:space:]]*axel-delete-raw([[:space:]]|$)/ { print; exit }
  '
}

verify_raw_bucket_lifecycle() {
  local config="$1"
  local bucket="$2"
  local output block
  output="$(wrangler r2 bucket lifecycle list "$bucket" -c "$config")"
  block="$(printf '%s\n' "$output" | lifecycle_rule_block)"
  if [ -z "$block" ]; then
    echo "[self-host] adding 30-day raw-payload expiry"
    wrangler r2 bucket lifecycle add "$bucket" axel-delete-raw \
      --expire-days 30 --force -c "$config"
    output="$(wrangler r2 bucket lifecycle list "$bucket" -c "$config")"
    block="$(printf '%s\n' "$output" | lifecycle_rule_block)"
  fi
  if [ -z "$block" ] \
    || ! printf '%s\n' "$block" | grep -Eq '^enabled:[[:space:]]+Yes[[:space:]]*$' \
    || ! printf '%s\n' "$block" | grep -Eq '^prefix:[[:space:]]+\(all prefixes\)[[:space:]]*$' \
    || ! printf '%s\n' "$block" | grep -Eq '^action:[[:space:]]+Expire objects after 30 days(,|[[:space:]]*$)'; then
    echo "[self-host] refusing raw bucket $bucket: lifecycle rule axel-delete-raw must be enabled, cover all prefixes, and expire objects after exactly 30 days" >&2
    exit 1
  fi
}

ensure_raw_bucket() {
  local config="$1"
  local bucket="$2"
  if wrangler r2 bucket info "$bucket" --json -c "$config" >/dev/null 2>&1; then
    verify_raw_bucket_private "$config" "$bucket"
    authorize_existing_resource OWNED_RAW_PAYLOAD_BUCKET "$bucket" "R2 bucket"
    verify_raw_bucket_lifecycle "$config" "$bucket"
    if ! resource_is_owned OWNED_RAW_PAYLOAD_BUCKET "$bucket"; then
      record_resource_ownership OWNED_RAW_PAYLOAD_BUCKET "$bucket"
    fi
  else
    echo "[self-host] creating R2 bucket $bucket"
    wrangler r2 bucket create "$bucket" -c "$config"
    record_resource_ownership OWNED_RAW_PAYLOAD_BUCKET "$bucket"
    verify_raw_bucket_private "$config" "$bucket"
    verify_raw_bucket_lifecycle "$config" "$bucket"
  fi
}

put_secret() {
  local config="$1"
  local name="$2"
  local value="$3"
  printf '%s' "$value" | wrangler secret put "$name" -c "$config" >/dev/null
}

command_init() {
  need_command node
  if [ -e "$ENV_FILE" ]; then
    echo "[self-host] refusing to overwrite existing $ENV_FILE" >&2
    exit 1
  fi
  node "$ROOT_DIR/scripts/self-host/env-file.mjs" init "$ENV_FILE"
  echo "[self-host] generated $ENV_FILE (mode 0600)"
  echo "[self-host] set AXEL_PUBLIC_URL, CLOUDFLARE_ACCOUNT_ID, and CLOUDFLARE_API_TOKEN, then run:"
  echo "  ./scripts/axel-self-host edge"
}

command_doctor() {
  need_command node
  need_command pnpm
  need_command docker
  docker compose version >/dev/null
  load_env
  local failed=0
  if [ -x "$WRANGLER_BIN" ]; then
    echo "[self-host] Wrangler: $($WRANGLER_BIN --version)"
  else
    echo "[self-host] workspace dependencies are missing; run 'pnpm install' or let the edge command install them"
    failed=1
  fi
  for name in AXEL_PUBLIC_URL AXEL_DELIVERY_PUBLIC_URL AXEL_RESOURCE_PREFIX AXEL_INSTALLATION_ID CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_API_TOKEN POSTGRES_PASSWORD DELIVERY_SHARED_SECRET SOURCE_LOOKUP_SHARED_SECRET INGEST_ADMIN_TOKEN CRON_SECRET; do
    if [ -z "${!name:-}" ]; then
      echo "[self-host] missing: $name"
      failed=1
    fi
  done
  if [[ "${CREDENTIALS_MASTER_KEY:-}" =~ ^[0-9a-fA-F]{64}$ ]]; then
    echo "[self-host] credentials master key: valid length"
  else
    echo "[self-host] CREDENTIALS_MASTER_KEY must be exactly 64 hex characters"
    failed=1
  fi
  if [[ "${AXEL_INSTALLATION_ID:-}" =~ ^[0-9a-fA-F]{32}$ ]]; then
    echo "[self-host] installation id: valid"
  else
    echo "[self-host] AXEL_INSTALLATION_ID must be exactly 32 hex characters"
    failed=1
  fi
  local secret_value
  for name in DELIVERY_SHARED_SECRET SOURCE_LOOKUP_SHARED_SECRET INGEST_ADMIN_TOKEN CRON_SECRET; do
    secret_value="${!name:-}"
    if [ "${#secret_value}" -lt 32 ]; then
      echo "[self-host] $name must contain at least 32 characters"
      failed=1
    fi
  done
  if [ "$failed" -ne 0 ]; then exit 1; fi
  echo "[self-host] prerequisites and required configuration look good"
}

command_edge() {
  need_command node
  need_command pnpm
  load_env
  require_value AXEL_RESOURCE_PREFIX
  require_value AXEL_INSTALLATION_ID
  require_value AXEL_DELIVERY_PUBLIC_URL
  require_value CLOUDFLARE_ACCOUNT_ID
  require_value CLOUDFLARE_API_TOKEN
  require_value DELIVERY_SHARED_SECRET
  require_value SOURCE_LOOKUP_SHARED_SECRET
  require_value INGEST_ADMIN_TOKEN
  case "$AXEL_DELIVERY_PUBLIC_URL" in
    https://localhost*|https://127.*)
      echo "[self-host] AXEL_DELIVERY_PUBLIC_URL must be reachable from Cloudflare, not localhost" >&2
      exit 1
      ;;
    https://*) ;;
    http://*)
      echo "[self-host] AXEL_DELIVERY_PUBLIC_URL must use https://; edge secrets and webhook data must not cross plaintext HTTP" >&2
      exit 1
      ;;
    *)
      echo "[self-host] AXEL_DELIVERY_PUBLIC_URL must start with https://" >&2
      exit 1
      ;;
  esac
  require_strong_secret DELIVERY_SHARED_SECRET
  require_strong_secret SOURCE_LOOKUP_SHARED_SECRET
  require_strong_secret INGEST_ADMIN_TOKEN
  if [[ ! "$AXEL_INSTALLATION_ID" =~ ^[0-9a-fA-F]{32}$ ]]; then
    echo "[self-host] AXEL_INSTALLATION_ID must be exactly 32 hex characters" >&2
    exit 1
  fi
  ensure_wrangler

  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  node "$ROOT_DIR/scripts/self-host/generate-wrangler.mjs" "$STATE_DIR"
  load_env_file "$STATE_DIR/resources.env"
  local ingest_config="$STATE_DIR/ingest.toml"
  local router_config="$STATE_DIR/router.toml"

  echo "[self-host] checking Cloudflare credentials"
  wrangler whoami --json -c "$ingest_config" >/dev/null
  # Validate the confidentiality boundary before any Worker can write payloads
  # and before creating other resources around a colliding bucket name.
  ensure_raw_bucket "$ingest_config" "$RAW_PAYLOAD_BUCKET"
  ensure_queue "$ingest_config" "$INGRESS_QUEUE" OWNED_INGRESS_QUEUE
  ensure_queue "$ingest_config" "$DELIVERY_QUEUE" OWNED_DELIVERY_QUEUE
  ensure_queue "$ingest_config" "$DEAD_QUEUE" OWNED_DEAD_QUEUE

  local queue_info
  queue_info="$(wrangler queues info "$DELIVERY_QUEUE" -c "$ingest_config")"
  if ! printf '%s\n' "$queue_info" | grep -q "HTTP Pull Consumer"; then
    echo "[self-host] enabling HTTP pull on $DELIVERY_QUEUE"
    wrangler queues consumer http add "$DELIVERY_QUEUE" \
      --batch-size 25 --message-retries 11 --dead-letter-queue "$DEAD_QUEUE" \
      --visibility-timeout-secs 300 -c "$ingest_config"
    queue_info="$(wrangler queues info "$DELIVERY_QUEUE" -c "$ingest_config")"
  fi
  local delivery_queue_id
  delivery_queue_id="$(printf '%s\n' "$queue_info" | sed -n 's/^Queue ID: //p' | tail -1)"
  if [ -z "$delivery_queue_id" ]; then
    echo "[self-host] could not read the delivery queue id" >&2
    exit 1
  fi

  echo "[self-host] deploying ingest worker"
  local deploy_output ingest_url
  deploy_output="$(wrangler deploy -c "$ingest_config" 2>&1 | tee /dev/stderr)"
  put_secret "$ingest_config" ADMIN_TOKEN "$INGEST_ADMIN_TOKEN"
  put_secret "$ingest_config" DELIVERY_SHARED_SECRET "$DELIVERY_SHARED_SECRET"
  put_secret "$ingest_config" SOURCE_LOOKUP_SHARED_SECRET "$SOURCE_LOOKUP_SHARED_SECRET"

  if [ -n "${AXEL_INGEST_DOMAIN:-}" ]; then
    ingest_url="https://${AXEL_INGEST_DOMAIN}"
  else
    ingest_url="$(printf '%s\n' "$deploy_output" \
      | grep -Eo 'https://[^[:space:]]+\.workers\.dev' \
      | tail -1 || true)"
  fi
  if [ -z "$ingest_url" ]; then
    echo "[self-host] deploy succeeded, but the workers.dev URL could not be parsed" >&2
    echo "[self-host] set NEXT_PUBLIC_AXEL_INGEST_URL in $ENV_FILE and rerun edge" >&2
    exit 1
  fi

  echo "[self-host] deploying router worker"
  wrangler deploy -c "$router_config"
  put_secret "$router_config" DELIVERY_SHARED_SECRET "$DELIVERY_SHARED_SECRET"

  node "$ROOT_DIR/scripts/self-host/env-file.mjs" set "$ENV_FILE" DELIVERY_QUEUE_ID "$delivery_queue_id"
  node "$ROOT_DIR/scripts/self-host/env-file.mjs" set "$ENV_FILE" RAW_PAYLOAD_BUCKET "$RAW_PAYLOAD_BUCKET"
  node "$ROOT_DIR/scripts/self-host/env-file.mjs" set "$ENV_FILE" NEXT_PUBLIC_AXEL_INGEST_URL "$ingest_url"
  echo "[self-host] edge ready: $ingest_url"
  echo "[self-host] next: ./scripts/axel-self-host up"
}

command_up() {
  need_command docker
  load_env
  for name in DELIVERY_QUEUE_ID RAW_PAYLOAD_BUCKET NEXT_PUBLIC_AXEL_INGEST_URL POSTGRES_PASSWORD CREDENTIALS_MASTER_KEY CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_API_TOKEN AXEL_PUBLIC_URL AXEL_DELIVERY_PUBLIC_URL; do
    require_value "$name"
  done
  require_strong_secret DELIVERY_SHARED_SECRET
  require_strong_secret SOURCE_LOOKUP_SHARED_SECRET
  require_strong_secret INGEST_ADMIN_TOKEN
  require_strong_secret CRON_SECRET
  compose up -d --build
  echo "[self-host] Axel is starting at $AXEL_PUBLIC_URL"
  echo "[self-host] run './scripts/axel-self-host status' to check health"
}

case "${1:-}" in
  init) command_init ;;
  edge) command_edge ;;
  up) command_up ;;
  status) load_env; compose ps ;;
  logs) load_env; compose logs -f --tail=200 ;;
  down) load_env; compose down ;;
  doctor) command_doctor ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
