#!/usr/bin/env bash
set +x
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ENV_FILE="${AXEL_SELF_HOST_ENV:-$ROOT_DIR/.env.selfhost}"
STATE_DIR="${AXEL_SELF_HOST_STATE_DIR:-$ROOT_DIR/.selfhost}"
OWNERSHIP_FILE="$STATE_DIR/ownership.env"
COMPOSE_FILE="$ROOT_DIR/docker-compose.selfhost.yml"
PUBLIC_COMPOSE_FILE="$ROOT_DIR/infra/self-host/docker-compose.public.yml"
WRANGLER_BIN="${AXEL_WRANGLER_BIN:-$ROOT_DIR/node_modules/.bin/wrangler}"
# Capture this one-shot operator acknowledgement before loading the env file so
# it cannot be made persistent accidentally inside .env.selfhost.
ADOPT_EXISTING_RESOURCES="${AXEL_ADOPT_EXISTING_RESOURCES:-}"

usage() {
  cat <<'EOF'
Usage: ./scripts/axel-self-host <command>

  init       Generate .env.selfhost with strong local secrets
  edge       Provision/deploy the Cloudflare Free-tier edge profile
  up         Build and start the private Docker stack
  status     Show container status
  logs       Follow container logs
  down       Stop containers without deleting data
  doctor     Check local prerequisites and configuration

Typical first run: init, edit three Cloudflare/public URL values, edge, up.
EOF
}

need_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "[self-host] missing required command: $1" >&2
    exit 1
  fi
}

load_env() {
  if [ ! -f "$ENV_FILE" ]; then
    echo "[self-host] $ENV_FILE does not exist; run './scripts/axel-self-host init' first" >&2
    exit 1
  fi
  load_env_file "$ENV_FILE"
}

load_env_file() {
  local path="$1"
  local line name value seen_names
  seen_names=$'\n'
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ""|\#*) continue ;;
    esac
    name="${line%%=*}"
    value="${line#*=}"
    if [ "$name" = "$line" ] || [[ ! "$name" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
      echo "[self-host] invalid environment entry in $path: $name" >&2
      exit 1
    fi
    case "$path" in
      "$ENV_FILE")
        case "$name" in
          AXEL_DEPLOYMENT_MODE|AXEL_INSTALLATION_ID|AXEL_SITE_ADDRESS|AXEL_PUBLIC_URL|AXEL_DELIVERY_PUBLIC_URL|AXEL_RESOURCE_PREFIX|AXEL_HTTP_PORT|AXEL_HTTPS_PORT|AXEL_PUBLISH_PUBLIC_PORTS|AXEL_LOCAL_BIND_ADDRESS|AXEL_LOCAL_PORT|AXEL_INGEST_DOMAIN|CLOUDFLARE_ACCOUNT_ID|CLOUDFLARE_API_TOKEN|CLOUDFLARE_RUNTIME_API_TOKEN|DELIVERY_QUEUE_ID|RAW_PAYLOAD_BUCKET|NEXT_PUBLIC_AXEL_INGEST_URL|POSTGRES_PASSWORD|POSTGRES_ADMIN_PASSWORD|POSTGRES_MIGRATION_PASSWORD|POSTGRES_DASHBOARD_PASSWORD|POSTGRES_DELIVERY_PASSWORD|CREDENTIALS_MASTER_KEY|DELIVERY_SHARED_SECRET|DELIVERY_SHARED_SECRET_PREVIOUS|SOURCE_LOOKUP_SHARED_SECRET|SOURCE_LOOKUP_SHARED_SECRET_PREVIOUS|ORDERING_KEY_HMAC_SECRET|INGEST_ADMIN_TOKEN|CRON_SECRET|RESEND_API_KEY|RESEND_FROM_EMAIL) ;;
          *)
            echo "[self-host] unapproved environment key in $path: $name" >&2
            exit 1
            ;;
        esac
        ;;
      "$STATE_DIR/resources.env")
        case "$name" in
          INGRESS_QUEUE|DELIVERY_QUEUE|DEAD_QUEUE|RAW_PAYLOAD_BUCKET|INGEST_WORKER_NAME|ROUTER_WORKER_NAME) ;;
          *)
            echo "[self-host] unapproved generated resource key in $path: $name" >&2
            exit 1
            ;;
        esac
        ;;
      *)
        echo "[self-host] refusing unapproved environment file: $path" >&2
        exit 1
        ;;
    esac
    if [[ "$seen_names" == *$'\n'"$name"$'\n'* ]]; then
      echo "[self-host] duplicate environment key in $path: $name" >&2
      exit 1
    fi
    seen_names+="$name"$'\n'
    # Quoted assignment exports the bytes as data. Never `source` this file:
    # operator-supplied URLs and tokens must not be evaluated as shell code.
    # The path-specific allowlist above also excludes interpreter and provider
    # controls such as BASH_ENV, NODE_OPTIONS, DOCKER_HOST, and COMPOSE_FILE.
    export "$name=$value"
  done < "$path"
  if [ -z "${POSTGRES_ADMIN_PASSWORD:-}" ] && [ -n "${POSTGRES_PASSWORD:-}" ]; then
    export POSTGRES_ADMIN_PASSWORD="$POSTGRES_PASSWORD"
  fi
}

require_value() {
  local name="$1"
  if [ -z "${!name:-}" ]; then
    echo "[self-host] set $name in $ENV_FILE" >&2
    exit 1
  fi
}

require_strong_secret() {
  local name="$1"
  local value
  require_value "$name"
  value="${!name}"
  if [ "${#value}" -lt 32 ]; then
    echo "[self-host] $name must contain at least 32 characters" >&2
    exit 1
  fi
}

require_database_password() {
  local name="$1"
  local value
  require_value "$name"
  value="${!name}"
  if [[ ! "$value" =~ ^[A-Za-z0-9_-]{40,128}$ ]]; then
    echo "[self-host] $name must contain 40-128 URL-safe characters" >&2
    exit 1
  fi
}

require_distinct_database_passwords() {
  local names=(
    POSTGRES_ADMIN_PASSWORD
    POSTGRES_MIGRATION_PASSWORD
    POSTGRES_DASHBOARD_PASSWORD
    POSTGRES_DELIVERY_PASSWORD
  )
  local left right left_name right_name
  for ((left = 0; left < ${#names[@]}; left += 1)); do
    for ((right = left + 1; right < ${#names[@]}; right += 1)); do
      left_name="${names[$left]}"
      right_name="${names[$right]}"
      if [ "${!left_name}" = "${!right_name}" ]; then
        echo "[self-host] Postgres admin, migration, dashboard, and delivery passwords must differ" >&2
        exit 1
      fi
    done
  done
}

compose() {
  local files=(--env-file "$ENV_FILE" -f "$COMPOSE_FILE")
  if publish_public_ports; then
    files+=(-f "$PUBLIC_COMPOSE_FILE")
  fi
  docker compose "${files[@]}" "$@"
}

publish_public_ports() {
  case "${AXEL_PUBLISH_PUBLIC_PORTS:-}" in
    1) return 0 ;;
    0) return 1 ;;
    "")
      # Compatibility for hand-written/older env files: infer only exact
      # loopback site labels as local. New `init` files record the choice.
      case "${AXEL_SITE_ADDRESS:-}" in
        http://localhost|http://localhost:*|https://localhost|https://localhost:*|localhost|localhost:*|\
        http://127.0.0.1|http://127.0.0.1:*|https://127.0.0.1|https://127.0.0.1:*|127.0.0.1|127.0.0.1:*|\
        http://\[::1\]|http://\[::1\]:*|https://\[::1\]|https://\[::1\]:*|\[::1\]|\[::1\]:*) return 1 ;;
        *) return 0 ;;
      esac
      ;;
    *)
      echo "[self-host] AXEL_PUBLISH_PUBLIC_PORTS must be 0 or 1" >&2
      exit 1
      ;;
  esac
}

wrangler() {
  local -a clean_env=(
    "NO_COLOR=1"
    "PATH=${PATH:-/usr/bin:/bin}"
  )
  local name
  for name in \
    HOME TMPDIR LANG LC_ALL LC_CTYPE TZ CI \
    HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY \
    http_proxy https_proxy all_proxy no_proxy \
    SSL_CERT_FILE SSL_CERT_DIR NODE_EXTRA_CA_CERTS; do
    if [ -n "${!name:-}" ]; then
      clean_env+=("$name=${!name}")
    fi
  done
  for name in CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_API_TOKEN; do
    if [ -n "${!name:-}" ]; then
      clean_env+=("$name=${!name}")
    fi
  done
  env -i "${clean_env[@]}" "$WRANGLER_BIN" "$@"
}

ensure_wrangler() {
  if [ ! -x "$WRANGLER_BIN" ]; then
    echo "[self-host] installing the pinned Cloudflare provisioner"
    # This runs before loading .env.selfhost. Ignore package lifecycle scripts
    # as a second boundary for secrets already exported by the caller.
    pnpm --dir "$ROOT_DIR" install --frozen-lockfile --ignore-scripts
  fi
  if [ ! -x "$WRANGLER_BIN" ]; then
    echo "[self-host] Wrangler was not installed at $WRANGLER_BIN" >&2
    exit 1
  fi
}

ownership_value() {
  local wanted="$1"
  local line name value
  [ -f "$OWNERSHIP_FILE" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    name="${line%%=*}"
    value="${line#*=}"
    if [ "$name" = "$wanted" ] && [ "$name" != "$line" ]; then
      printf '%s' "$value"
      return 0
    fi
  done < "$OWNERSHIP_FILE"
  return 1
}

resource_is_owned() {
  local key="$1"
  local name="$2"
  [ "$(ownership_value AXEL_INSTALLATION_ID 2>/dev/null || true)" = "$AXEL_INSTALLATION_ID" ] \
    && [ "$(ownership_value "${key}_ACCOUNT_ID" 2>/dev/null || true)" = "$CLOUDFLARE_ACCOUNT_ID" ] \
    && [ "$(ownership_value "$key" 2>/dev/null || true)" = "$name" ]
}

record_resource_ownership() {
  local key="$1"
  local name="$2"
  node "$ROOT_DIR/scripts/self-host/env-file.mjs" set \
    "$OWNERSHIP_FILE" AXEL_INSTALLATION_ID "$AXEL_INSTALLATION_ID"
  node "$ROOT_DIR/scripts/self-host/env-file.mjs" set \
    "$OWNERSHIP_FILE" "${key}_ACCOUNT_ID" "$CLOUDFLARE_ACCOUNT_ID"
  node "$ROOT_DIR/scripts/self-host/env-file.mjs" set "$OWNERSHIP_FILE" "$key" "$name"
}

authorize_existing_resource() {
  local key="$1"
  local name="$2"
  local kind="$3"
  if resource_is_owned "$key" "$name"; then
    return 0
  fi
  if [ "$ADOPT_EXISTING_RESOURCES" = "1" ]; then
    echo "[self-host] explicitly adopting existing $kind $name"
    return 0
  fi
  echo "[self-host] refusing to reuse pre-existing $kind $name without local ownership proof" >&2
  echo "[self-host] choose a different AXEL_RESOURCE_PREFIX, restore $OWNERSHIP_FILE, or inspect the resource and rerun once with AXEL_ADOPT_EXISTING_RESOURCES=1" >&2
  exit 1
}

ensure_queue() {
  local config="$1"
  local queue="$2"
  local ownership_key="$3"
  if wrangler queues info "$queue" -c "$config" >/dev/null 2>&1; then
    authorize_existing_resource "$ownership_key" "$queue" "queue"
    if ! resource_is_owned "$ownership_key" "$queue"; then
      record_resource_ownership "$ownership_key" "$queue"
    fi
  else
    echo "[self-host] creating queue $queue"
    wrangler queues create "$queue" --message-retention-period-secs 86400 -c "$config"
    record_resource_ownership "$ownership_key" "$queue"
  fi
}

verify_raw_bucket_private() {
  local config="$1"
  local bucket="$2"
  local dev_url_output domain_output
  dev_url_output="$(wrangler r2 bucket dev-url get "$bucket" -c "$config")"
  if ! printf '%s\n' "$dev_url_output" | grep -Fq "Public access via the r2.dev URL is disabled."; then
    echo "[self-host] refusing raw bucket $bucket: public r2.dev access is enabled or could not be verified disabled" >&2
    exit 1
  fi
  domain_output="$(wrangler r2 bucket domain list "$bucket" -c "$config")"
  if ! printf '%s\n' "$domain_output" | grep -Fq "There are no custom domains connected to this bucket."; then
    echo "[self-host] refusing raw bucket $bucket: a custom domain is attached or absence could not be verified" >&2
    exit 1
  fi
}

lifecycle_rule_block() {
  awk -v RS='' '
    $0 ~ /(^|\n)name:[[:space:]]*axel-delete-raw([[:space:]]|$)/ { print; exit }
  '
}

verify_raw_bucket_lifecycle() {
  local config="$1"
  local bucket="$2"
  local output block
  output="$(wrangler r2 bucket lifecycle list "$bucket" -c "$config")"
  block="$(printf '%s\n' "$output" | lifecycle_rule_block)"
  if [ -z "$block" ]; then
    echo "[self-host] adding 30-day raw-payload expiry"
    wrangler r2 bucket lifecycle add "$bucket" axel-delete-raw \
      --expire-days 30 --force -c "$config"
    output="$(wrangler r2 bucket lifecycle list "$bucket" -c "$config")"
    block="$(printf '%s\n' "$output" | lifecycle_rule_block)"
  fi
  if [ -z "$block" ] \
    || ! printf '%s\n' "$block" | grep -Eq '^enabled:[[:space:]]+Yes[[:space:]]*$' \
    || ! printf '%s\n' "$block" | grep -Eq '^prefix:[[:space:]]+\(all prefixes\)[[:space:]]*$' \
    || ! printf '%s\n' "$block" | grep -Eq '^action:[[:space:]]+Expire objects after 30 days(,|[[:space:]]*$)'; then
    echo "[self-host] refusing raw bucket $bucket: lifecycle rule axel-delete-raw must be enabled, cover all prefixes, and expire objects after exactly 30 days" >&2
    exit 1
  fi
}

ensure_raw_bucket() {
  local config="$1"
  local bucket="$2"
  if wrangler r2 bucket info "$bucket" --json -c "$config" >/dev/null 2>&1; then
    verify_raw_bucket_private "$config" "$bucket"
    authorize_existing_resource OWNED_RAW_PAYLOAD_BUCKET "$bucket" "R2 bucket"
    verify_raw_bucket_lifecycle "$config" "$bucket"
    if ! resource_is_owned OWNED_RAW_PAYLOAD_BUCKET "$bucket"; then
      record_resource_ownership OWNED_RAW_PAYLOAD_BUCKET "$bucket"
    fi
  else
    echo "[self-host] creating R2 bucket $bucket"
    wrangler r2 bucket create "$bucket" -c "$config"
    record_resource_ownership OWNED_RAW_PAYLOAD_BUCKET "$bucket"
    verify_raw_bucket_private "$config" "$bucket"
    verify_raw_bucket_lifecycle "$config" "$bucket"
  fi
}

release_edge_workers() (
  local ingest_config="$1"
  local router_config="$2"
  local ingest_worker_name="$3"
  local router_worker_name="$4"
  local release_nonce ingest_tag router_tag release_dir
  local ingest_prior_state router_prior_state
  local ingest_activation_attempted=0
  local router_activation_attempted=0
  local ADMIN_TOKEN="$INGEST_ADMIN_TOKEN"
  export ADMIN_TOKEN
  release_nonce="$(node -e 'process.stdout.write(require("node:crypto").randomBytes(8).toString("hex"))')"
  ingest_tag="selfhost-ingest-${AXEL_INSTALLATION_ID}-${release_nonce}"
  router_tag="selfhost-router-${AXEL_INSTALLATION_ID}-${release_nonce}"
  release_dir="$(mktemp -d "$STATE_DIR/.worker-release.XXXXXX")"
  chmod 700 "$release_dir"
  umask 077

  cleanup_worker_release() {
    rm -f -- \
      "$release_dir/ingest-secrets.json" \
      "$release_dir/router-secrets.json" \
      "$release_dir/ingest-prior.json" \
      "$release_dir/router-prior.json" \
      "$release_dir/ingest-versions.json" \
      "$release_dir/ingest-deployment.json" \
      "$release_dir/router-versions.json" \
      "$release_dir/router-deployment.json" \
      "$release_dir/ingest-rollback-deployment.json" \
      "$release_dir/router-rollback-deployment.json"
    rmdir "$release_dir" 2>/dev/null || true
  }
  trap cleanup_worker_release EXIT

  stage_worker_version() {
    local config="$1"
    local tag="$2"
    local secret_file="$3"
    shift 3
    if ! node "$ROOT_DIR/scripts/self-host/cloudflare-worker-release.mjs" \
      write-secrets "$secret_file" "$@"; then
      echo "[self-host] could not prepare the protected Worker secret file" >&2
      return 1
    fi
    if ! wrangler versions upload \
      --secrets-file "$secret_file" \
      --tag "$tag" \
      --message "Axel self-host atomic release" \
      -c "$config" >/dev/null 2>&1; then
      echo "[self-host] Cloudflare Worker version staging failed; production was not activated" >&2
      return 1
    fi
    rm -f -- "$secret_file"
  }

  activate_worker_version() {
    local config="$1"
    local tag="$2"
    if ! wrangler versions deploy \
      --version-tag "$tag" \
      --percentage 100 \
      --message "Activate Axel self-host atomic release" \
      --yes \
      -c "$config" >/dev/null 2>&1; then
      echo "[self-host] Cloudflare Worker version activation failed" >&2
      return 1
    fi
  }

  verify_worker_version() {
    local config="$1"
    local tag="$2"
    local label="$3"
    if ! wrangler versions list --json -c "$config" \
      > "$release_dir/${label}-versions.json" 2>/dev/null \
      || ! wrangler deployments status --json -c "$config" \
        > "$release_dir/${label}-deployment.json" 2>/dev/null \
      || ! node "$ROOT_DIR/scripts/self-host/cloudflare-worker-release.mjs" \
        verify-active \
        "$release_dir/${label}-versions.json" \
        "$release_dir/${label}-deployment.json" \
        "$tag"; then
      echo "[self-host] Cloudflare Worker activation readback failed" >&2
      return 1
    fi
  }

  capture_worker_version() {
    local worker_name="$1"
    local state_path="$2"
    if ! node "$ROOT_DIR/scripts/self-host/cloudflare-worker-release.mjs" \
      capture-active "$worker_name" "$state_path" >/dev/null 2>&1; then
      echo "[self-host] Cloudflare Worker active-version capture failed; no Worker version was staged" >&2
      return 1
    fi
  }

  rollback_worker_version() {
    local config="$1"
    local state_path="$2"
    local label="$3"
    local prior_version
    if ! prior_version="$(
      node "$ROOT_DIR/scripts/self-host/cloudflare-worker-release.mjs" \
        read-captured "$state_path" 2>/dev/null
    )"; then
      echo "[self-host] $label Worker rollback state is invalid" >&2
      return 1
    fi
    case "$prior_version" in
      absent)
        echo "[self-host] $label Worker had no prior deployment; automatic recovery is incomplete" >&2
        return 1
        ;;
      active:*) prior_version="${prior_version#active:}" ;;
      *)
        echo "[self-host] $label Worker rollback state is invalid" >&2
        return 1
        ;;
    esac
    if ! wrangler versions deploy \
      --version-id "$prior_version" \
      --percentage 100 \
      --message "Restore prior Axel self-host release" \
      --yes \
      -c "$config" >/dev/null 2>&1; then
      echo "[self-host] $label Worker rollback activation failed" >&2
      return 1
    fi
    if ! wrangler deployments status --json -c "$config" \
      > "$release_dir/${label}-rollback-deployment.json" 2>/dev/null \
      || ! node "$ROOT_DIR/scripts/self-host/cloudflare-worker-release.mjs" \
        verify-version \
        "$release_dir/${label}-rollback-deployment.json" \
        "$prior_version" >/dev/null 2>&1; then
      echo "[self-host] $label Worker rollback readback failed" >&2
      return 1
    fi
  }

  rollback_release() {
    local recovery_complete=1
    if [ "$ingest_activation_attempted" = "1" ]; then
      rollback_worker_version "$ingest_config" "$ingest_prior_state" ingest \
        || recovery_complete=0
    fi
    if [ "$router_activation_attempted" = "1" ]; then
      rollback_worker_version "$router_config" "$router_prior_state" router \
        || recovery_complete=0
    fi
    if [ "$recovery_complete" = "1" ]; then
      echo "[self-host] failed Worker release restored every prior active deployment" >&2
    else
      echo "[self-host] failed Worker release recovery is incomplete; inspect both Workers before retrying" >&2
    fi
    return 1
  }

  ingest_prior_state="$release_dir/ingest-prior.json"
  router_prior_state="$release_dir/router-prior.json"
  # Capture both production states before the first inactive upload. A split or
  # non-100% deployment is rejected rather than normalized implicitly.
  capture_worker_version "$ingest_worker_name" "$ingest_prior_state"
  capture_worker_version "$router_worker_name" "$router_prior_state"

  # Stage both complete code+secret versions before either Worker is allowed to
  # receive production traffic. A failure during either upload leaves both live
  # Workers untouched; no sequence of `secret put` mutations is used.
  stage_worker_version \
    "$ingest_config" "$ingest_tag" "$release_dir/ingest-secrets.json" \
    ADMIN_TOKEN DELIVERY_SHARED_SECRET SOURCE_LOOKUP_SHARED_SECRET \
    ORDERING_KEY_HMAC_SECRET
  stage_worker_version \
    "$router_config" "$router_tag" "$release_dir/router-secrets.json" \
    DELIVERY_SHARED_SECRET

  ingest_activation_attempted=1
  if ! activate_worker_version "$ingest_config" "$ingest_tag"; then
    rollback_release
  fi
  router_activation_attempted=1
  if ! activate_worker_version "$router_config" "$router_tag"; then
    rollback_release
  fi

  # Routes, workers.dev, and Queue consumers are non-versioned Cloudflare
  # triggers. Apply them only after both atomic versions are active.
  if ! wrangler triggers deploy -c "$ingest_config" >/dev/null 2>&1 \
    || ! wrangler triggers deploy -c "$router_config" >/dev/null 2>&1; then
    echo "[self-host] Cloudflare Worker trigger deployment failed" >&2
    rollback_release
  fi

  if ! verify_worker_version "$ingest_config" "$ingest_tag" ingest \
    || ! verify_worker_version "$router_config" "$router_tag" router; then
    rollback_release
  fi
)

command_init() {
  need_command node
  if [ -e "$ENV_FILE" ]; then
    echo "[self-host] refusing to overwrite existing $ENV_FILE" >&2
    exit 1
  fi
  node "$ROOT_DIR/scripts/self-host/env-file.mjs" init "$ENV_FILE"
  echo "[self-host] generated $ENV_FILE (mode 0600)"
  echo "[self-host] set AXEL_PUBLIC_URL, CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, and CLOUDFLARE_RUNTIME_API_TOKEN, then run:"
  echo "  ./scripts/axel-self-host edge"
}

command_doctor() {
  need_command node
  need_command pnpm
  need_command docker
  docker compose version >/dev/null
  load_env
  local failed=0
  if [ -x "$WRANGLER_BIN" ]; then
    echo "[self-host] Wrangler: $(wrangler --version)"
  else
    echo "[self-host] workspace dependencies are missing; run 'pnpm install' or let the edge command install them"
    failed=1
  fi
  for name in AXEL_PUBLIC_URL AXEL_DELIVERY_PUBLIC_URL AXEL_RESOURCE_PREFIX AXEL_INSTALLATION_ID CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_API_TOKEN CLOUDFLARE_RUNTIME_API_TOKEN DELIVERY_SHARED_SECRET SOURCE_LOOKUP_SHARED_SECRET ORDERING_KEY_HMAC_SECRET INGEST_ADMIN_TOKEN CRON_SECRET; do
    if [ -z "${!name:-}" ]; then
      echo "[self-host] missing: $name"
      failed=1
    fi
  done
  for name in POSTGRES_ADMIN_PASSWORD POSTGRES_MIGRATION_PASSWORD POSTGRES_DASHBOARD_PASSWORD POSTGRES_DELIVERY_PASSWORD; do
    require_database_password "$name"
  done
  require_distinct_database_passwords
  if [ -n "${CLOUDFLARE_API_TOKEN:-}" ] \
    && [ "${CLOUDFLARE_API_TOKEN}" = "${CLOUDFLARE_RUNTIME_API_TOKEN:-}" ]; then
    echo "[self-host] CLOUDFLARE_RUNTIME_API_TOKEN must differ from the provisioning token"
    failed=1
  fi
  if [[ "${CREDENTIALS_MASTER_KEY:-}" =~ ^[0-9a-fA-F]{64}$ ]]; then
    echo "[self-host] credentials master key: valid length"
  else
    echo "[self-host] CREDENTIALS_MASTER_KEY must be exactly 64 hex characters"
    failed=1
  fi
  if [[ "${AXEL_INSTALLATION_ID:-}" =~ ^[0-9a-fA-F]{32}$ ]]; then
    echo "[self-host] installation id: valid"
  else
    echo "[self-host] AXEL_INSTALLATION_ID must be exactly 32 hex characters"
    failed=1
  fi
  local secret_value
  for name in DELIVERY_SHARED_SECRET SOURCE_LOOKUP_SHARED_SECRET ORDERING_KEY_HMAC_SECRET INGEST_ADMIN_TOKEN CRON_SECRET; do
    secret_value="${!name:-}"
    if [ "${#secret_value}" -lt 32 ]; then
      echo "[self-host] $name must contain at least 32 characters"
      failed=1
    fi
  done
  if [ -n "${DELIVERY_SHARED_SECRET_PREVIOUS:-}" ]; then
    if [ "${#DELIVERY_SHARED_SECRET_PREVIOUS}" -lt 32 ] \
      || [ "$DELIVERY_SHARED_SECRET_PREVIOUS" = "${DELIVERY_SHARED_SECRET:-}" ]; then
      echo "[self-host] DELIVERY_SHARED_SECRET_PREVIOUS must be a distinct 32+ character rotation credential"
      failed=1
    fi
  fi
  if [ -n "${SOURCE_LOOKUP_SHARED_SECRET_PREVIOUS:-}" ]; then
    if [ "${#SOURCE_LOOKUP_SHARED_SECRET_PREVIOUS}" -lt 32 ] \
      || [ "$SOURCE_LOOKUP_SHARED_SECRET_PREVIOUS" = "${SOURCE_LOOKUP_SHARED_SECRET:-}" ]; then
      echo "[self-host] SOURCE_LOOKUP_SHARED_SECRET_PREVIOUS must be a distinct 32+ character rotation credential"
      failed=1
    fi
  fi
  if [ "$failed" -ne 0 ]; then exit 1; fi
  echo "[self-host] prerequisites and required configuration look good"
}

command_edge() {
  need_command node
  need_command pnpm
  ensure_wrangler
  load_env
  require_value AXEL_RESOURCE_PREFIX
  require_value AXEL_INSTALLATION_ID
  require_value AXEL_DELIVERY_PUBLIC_URL
  require_value CLOUDFLARE_ACCOUNT_ID
  require_value CLOUDFLARE_API_TOKEN
  require_value CLOUDFLARE_RUNTIME_API_TOKEN
  if [[ ! "$CLOUDFLARE_ACCOUNT_ID" =~ ^[A-Za-z0-9_-]{3,128}$ ]]; then
    echo "[self-host] CLOUDFLARE_ACCOUNT_ID contains invalid characters" >&2
    exit 1
  fi
  if [ "$CLOUDFLARE_API_TOKEN" = "$CLOUDFLARE_RUNTIME_API_TOKEN" ]; then
    echo "[self-host] CLOUDFLARE_RUNTIME_API_TOKEN must differ from the provisioning token" >&2
    exit 1
  fi
  require_value DELIVERY_SHARED_SECRET
  require_value SOURCE_LOOKUP_SHARED_SECRET
  require_value ORDERING_KEY_HMAC_SECRET
  require_value INGEST_ADMIN_TOKEN
  case "$AXEL_DELIVERY_PUBLIC_URL" in
    https://localhost*|https://127.*)
      echo "[self-host] AXEL_DELIVERY_PUBLIC_URL must be reachable from Cloudflare, not localhost" >&2
      exit 1
      ;;
    https://*) ;;
    http://*)
      echo "[self-host] AXEL_DELIVERY_PUBLIC_URL must use https://; edge secrets and webhook data must not cross plaintext HTTP" >&2
      exit 1
      ;;
    *)
      echo "[self-host] AXEL_DELIVERY_PUBLIC_URL must start with https://" >&2
      exit 1
      ;;
  esac
  require_strong_secret DELIVERY_SHARED_SECRET
  if [ -n "${DELIVERY_SHARED_SECRET_PREVIOUS:-}" ]; then
    require_strong_secret DELIVERY_SHARED_SECRET_PREVIOUS
    if [ "$DELIVERY_SHARED_SECRET_PREVIOUS" = "$DELIVERY_SHARED_SECRET" ]; then
      echo "[self-host] DELIVERY_SHARED_SECRET_PREVIOUS must differ from DELIVERY_SHARED_SECRET" >&2
      exit 1
    fi
  fi
  require_strong_secret SOURCE_LOOKUP_SHARED_SECRET
  if [ -n "${SOURCE_LOOKUP_SHARED_SECRET_PREVIOUS:-}" ]; then
    require_strong_secret SOURCE_LOOKUP_SHARED_SECRET_PREVIOUS
    if [ "$SOURCE_LOOKUP_SHARED_SECRET_PREVIOUS" = "$SOURCE_LOOKUP_SHARED_SECRET" ]; then
      echo "[self-host] SOURCE_LOOKUP_SHARED_SECRET_PREVIOUS must differ from SOURCE_LOOKUP_SHARED_SECRET" >&2
      exit 1
    fi
  fi
  require_strong_secret ORDERING_KEY_HMAC_SECRET
  require_strong_secret INGEST_ADMIN_TOKEN
  if [[ ! "$AXEL_INSTALLATION_ID" =~ ^[0-9a-fA-F]{32}$ ]]; then
    echo "[self-host] AXEL_INSTALLATION_ID must be exactly 32 hex characters" >&2
    exit 1
  fi
  local ingest_url=""
  if [ -n "${AXEL_INGEST_DOMAIN:-}" ]; then
    ingest_url="$(
      node "$ROOT_DIR/scripts/self-host/cloudflare-worker-release.mjs" \
        custom-url "$AXEL_INGEST_DOMAIN"
    )"
  fi
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  node "$ROOT_DIR/scripts/self-host/generate-wrangler.mjs" "$STATE_DIR"
  load_env_file "$STATE_DIR/resources.env"
  local ingest_config="$STATE_DIR/ingest.toml"
  local router_config="$STATE_DIR/router.toml"

  echo "[self-host] checking Cloudflare credentials"
  wrangler whoami --json -c "$ingest_config" >/dev/null
  # Validate the confidentiality boundary before any Worker can write payloads
  # and before creating other resources around a colliding bucket name.
  ensure_raw_bucket "$ingest_config" "$RAW_PAYLOAD_BUCKET"
  ensure_queue "$ingest_config" "$INGRESS_QUEUE" OWNED_INGRESS_QUEUE
  ensure_queue "$ingest_config" "$DELIVERY_QUEUE" OWNED_DELIVERY_QUEUE
  ensure_queue "$ingest_config" "$DEAD_QUEUE" OWNED_DEAD_QUEUE

  local queue_info
  queue_info="$(wrangler queues info "$DELIVERY_QUEUE" -c "$ingest_config")"
  if ! printf '%s\n' "$queue_info" | grep -q "HTTP Pull Consumer"; then
    echo "[self-host] enabling HTTP pull on $DELIVERY_QUEUE"
    wrangler queues consumer http add "$DELIVERY_QUEUE" \
      --batch-size 25 --message-retries 11 --dead-letter-queue "$DEAD_QUEUE" \
      --visibility-timeout-secs 300 -c "$ingest_config"
    queue_info="$(wrangler queues info "$DELIVERY_QUEUE" -c "$ingest_config")"
  fi
  local delivery_queue_id
  delivery_queue_id="$(printf '%s\n' "$queue_info" | sed -n 's/^Queue ID: //p' | tail -1)"
  if [ -z "$delivery_queue_id" ]; then
    echo "[self-host] could not read the delivery queue id" >&2
    exit 1
  fi

  CLOUDFLARE_RUNTIME_API_TOKEN="$CLOUDFLARE_RUNTIME_API_TOKEN" \
    DELIVERY_QUEUE_ID="$delivery_queue_id" \
    RAW_PAYLOAD_BUCKET="$RAW_PAYLOAD_BUCKET" \
    node "$ROOT_DIR/scripts/self-host/verify-runtime-token.mjs"

  echo "[self-host] staging and activating atomic Worker releases"
  release_edge_workers \
    "$ingest_config" "$router_config" "$INGEST_WORKER_NAME" "$ROUTER_WORKER_NAME"

  if [ -z "$ingest_url" ]; then
    ingest_url="$(
      node "$ROOT_DIR/scripts/self-host/cloudflare-worker-release.mjs" \
        workers-dev-url "$INGEST_WORKER_NAME"
    )"
  fi

  node "$ROOT_DIR/scripts/self-host/env-file.mjs" set "$ENV_FILE" DELIVERY_QUEUE_ID "$delivery_queue_id"
  node "$ROOT_DIR/scripts/self-host/env-file.mjs" set "$ENV_FILE" RAW_PAYLOAD_BUCKET "$RAW_PAYLOAD_BUCKET"
  node "$ROOT_DIR/scripts/self-host/env-file.mjs" set "$ENV_FILE" NEXT_PUBLIC_AXEL_INGEST_URL "$ingest_url"
  echo "[self-host] edge ready: $ingest_url"
  echo "[self-host] next: ./scripts/axel-self-host up"
}

command_up() {
  need_command docker
  need_command node
  load_env
  for name in DELIVERY_QUEUE_ID RAW_PAYLOAD_BUCKET NEXT_PUBLIC_AXEL_INGEST_URL CREDENTIALS_MASTER_KEY CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_API_TOKEN CLOUDFLARE_RUNTIME_API_TOKEN AXEL_PUBLIC_URL AXEL_DELIVERY_PUBLIC_URL; do
    require_value "$name"
  done
  for name in POSTGRES_ADMIN_PASSWORD POSTGRES_MIGRATION_PASSWORD POSTGRES_DASHBOARD_PASSWORD POSTGRES_DELIVERY_PASSWORD; do
    require_database_password "$name"
  done
  require_distinct_database_passwords
  if [ "$CLOUDFLARE_API_TOKEN" = "$CLOUDFLARE_RUNTIME_API_TOKEN" ]; then
    echo "[self-host] CLOUDFLARE_RUNTIME_API_TOKEN must differ from the provisioning token" >&2
    exit 1
  fi
  require_strong_secret DELIVERY_SHARED_SECRET
  if [ -n "${DELIVERY_SHARED_SECRET_PREVIOUS:-}" ]; then
    require_strong_secret DELIVERY_SHARED_SECRET_PREVIOUS
    if [ "$DELIVERY_SHARED_SECRET_PREVIOUS" = "$DELIVERY_SHARED_SECRET" ]; then
      echo "[self-host] DELIVERY_SHARED_SECRET_PREVIOUS must differ from DELIVERY_SHARED_SECRET" >&2
      exit 1
    fi
  fi
  require_strong_secret SOURCE_LOOKUP_SHARED_SECRET
  if [ -n "${SOURCE_LOOKUP_SHARED_SECRET_PREVIOUS:-}" ]; then
    require_strong_secret SOURCE_LOOKUP_SHARED_SECRET_PREVIOUS
    if [ "$SOURCE_LOOKUP_SHARED_SECRET_PREVIOUS" = "$SOURCE_LOOKUP_SHARED_SECRET" ]; then
      echo "[self-host] SOURCE_LOOKUP_SHARED_SECRET_PREVIOUS must differ from SOURCE_LOOKUP_SHARED_SECRET" >&2
      exit 1
    fi
  fi
  require_strong_secret ORDERING_KEY_HMAC_SECRET
  require_strong_secret INGEST_ADMIN_TOKEN
  require_strong_secret CRON_SECRET
  node "$ROOT_DIR/scripts/self-host/verify-runtime-token.mjs"
  compose up -d --build
  echo "[self-host] Axel is starting at $AXEL_PUBLIC_URL"
  echo "[self-host] run './scripts/axel-self-host status' to check health"
}

case "${1:-}" in
  init) command_init ;;
  edge) command_edge ;;
  up) command_up ;;
  status) load_env; compose ps ;;
  logs) load_env; compose logs -f --tail=200 ;;
  down) load_env; compose down ;;
  doctor) command_doctor ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
